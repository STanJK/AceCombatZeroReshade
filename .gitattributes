# Keep archived evidence and compatibility hashes identical on Windows and Linux.
* text=auto eol=lf
*.gz -text
*.zip -text
*.png -text
*.jpg -text
*.exe -text
*.dll -text
*.addon64 -text
# Preserve verbatim Ghidra output, including its generated blank lines/spaces.
docs/reverse-engineering/coop/cockpit/decompiled/*.c whitespace=-blank-at-eol,-blank-at-eof
